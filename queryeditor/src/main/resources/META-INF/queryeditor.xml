<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="JAVA"
                                  implementation="com.look4counter.queryeditor.JavaQueryReferenceContributor"/>
        <projectService serviceInterface="com.look4counter.queryeditor.QueryCreationDialogs"
                        serviceImplementation="com.look4counter.queryeditor.DefaultQueryCreationDialogs"/>
        <postStartupActivity implementation="com.look4counter.queryeditor.queryindex.QueryIdIndexStartupActivity"/>
        <postStartupActivity implementation="com.look4counter.queryeditor.database.DatabaseMetadataStartupActivity"/>
        <fileType name="Glue SQL"
                  language="XML"
                  implementationClass="com.look4counter.queryeditor.GlueSqlFileType"
                  fieldName="INSTANCE"
                  extensions="glue_sql"/>
        <fileEditorProvider implementation="com.look4counter.queryeditor.QueryDesignEditorProvider"/>
        <fileEditorProvider implementation="com.look4counter.queryeditor.QuerySourceEditorProvider"/>
        <groupConfigurable id="com.look4counter.glueframework"
                           bundle="messages.GlueFrameworkBundle"
                           displayNameKey="settings.group.name"
                           descriptionKey="settings.group.description"/>
        <groupConfigurable id="com.look4counter.glueframework.queryeditor"
                           parentId="com.look4counter.glueframework"
                           bundle="messages.GlueFrameworkBundle"
                           displayNameKey="settings.queryeditor.name"
                           descriptionKey="settings.queryeditor.description"/>
        <projectConfigurable id="com.look4counter.glueframework.queryeditor.tool"
                             groupId="com.look4counter.glueframework.queryeditor" displayName="Tool"
                             nonDefaultProject="true"
                             instance="com.look4counter.queryeditor.settings.GlueQueryToolConfigurable"/>
        <projectConfigurable id="com.look4counter.glueframework.queryeditor.database"
                             groupId="com.look4counter.glueframework.queryeditor" displayName="Database"
                             nonDefaultProject="true"
                             instance="com.look4counter.queryeditor.settings.GlueQueryDatabaseConfigurable"/>
    </extensions>
    <applicationListeners>
        <listener class="com.look4counter.queryeditor.QuerySaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>
    <projectListeners>
        <listener class="com.look4counter.queryeditor.QueryOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
